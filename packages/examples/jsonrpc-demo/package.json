{
  "name": "@freddie/freddie-sdk-jsonrpc-demo",
  "description": "Bin that boots an external Cordis config for the stdio JSON-RPC SDK runtime",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lanmower/freddie.git",
    "directory": "packages/examples/jsonrpc-demo"
  },
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "dsh-jsonrpc-agent": "src/bin.js"
  },
  "exports": {
    ".": {
      "default": "./src/index.js"
    },
    "./invariant": {
      "default": "./src/invariant.js"
    },
    "./bin": {
      "default": "./src/bin.js"
    },
    "./packaged-bin": {
      "default": "./src/packaged-bin.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "src/index.js",
    "src/invariant.js",
    "src/bin.js",
    "src/packaged-bin.js",
    "src/runner.js"
  ],
  "license": "MIT",
  "dependencies": {
    "@freddie/freddie-app-boot": "workspace:^"
  },
  "peerDependencies": {
    "@freddie/freddie-invariants": "workspace:^",
    "@freddie/cordis": "workspace:^"
  },
  "devDependencies": {
    "@freddie/freddie-invariants": "workspace:^",
    "@freddie/cordis": "workspace:^"
  }
}
