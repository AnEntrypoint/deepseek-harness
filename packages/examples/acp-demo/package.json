    "directory": "packages/examples/acp-demo"
  },
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "dsh-acp-demo": "src/bin.js"
  },
  "exports": {
    ".": {
      "default": "./src/index.js"
    },
    "./invariant": {
      "default": "./src/invariant.js"
    },
    "./bin": {
      "default": "./src/bin.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
