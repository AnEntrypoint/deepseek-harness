{
  "name": "@freddie/freddie-goal-round-driver",
  "description": "Race-fenced same-session goal-round driver",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lanmower/freddie.git",
    "directory": "packages/goal/goal-round-driver"
  },
  "type": "module",
  "main": "src/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./src/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./src/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "src/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@freddie/freddie-agent": "workspace:^",
    "@freddie/freddie-goal": "workspace:^",
    "@freddie/freddie-invariants": "workspace:^",
    "@freddie/freddie-llm": "workspace:^",
    "@freddie/freddie-session": "workspace:^",
    "@freddie/cordis": "workspace:^"
  },
  "devDependencies": {
    "@freddie/freddie-agent": "workspace:^",
    "@freddie/freddie-agent-loop": "workspace:^",
    "@freddie/freddie-goal": "workspace:^",
    "@freddie/freddie-invariants": "workspace:^",
    "@freddie/freddie-llm": "workspace:^",
    "@freddie/freddie-session": "workspace:^",
    "@freddie/freddie-system-prompt": "workspace:^",
    "@freddie/freddie-tools": "workspace:^",
    "@freddie/cordis": "workspace:^"
  }
}
