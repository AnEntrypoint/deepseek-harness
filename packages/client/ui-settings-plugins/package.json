{
  "name": "@deepseek-ai/dsh-client-ui-settings-plugins",
  "description": "Plugins settings section with feature-owned tabs and configurable host-plane plugin cards",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/client/ui-settings-plugins"
  },
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": {
      "default": "./src/index.js"
    },
    "./invariant": {
      "default": "./src/invariant.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/dsh-api-remotes": "workspace:^",
    "@deepseek-ai/dsh-client-connection": "workspace:^",
    "@deepseek-ai/dsh-client-locale": "workspace:^",
    "@deepseek-ai/dsh-client-runtime": "workspace:^",
    "@deepseek-ai/dsh-client-ui-settings": "workspace:^",
    "@deepseek-ai/dsh-invariants": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/dsh-api-remotes": "workspace:^",
    "@deepseek-ai/dsh-client-connection": "workspace:^",
    "@deepseek-ai/dsh-client-locale": "workspace:^",
    "@deepseek-ai/dsh-client-runtime": "workspace:^",
    "@deepseek-ai/dsh-client-ui-primitives": "workspace:^",
    "@deepseek-ai/dsh-client-ui-settings": "workspace:^",
    "@deepseek-ai/dsh-client-ui-slots": "workspace:^",
    "@deepseek-ai/dsh-invariants": "workspace:^"
  },
  "files": [
    "src/index.js",
    "src/invariant.js",
    "src/client/index.js",
    "src/client/AgentLoopCard.js",
    "src/client/BashCard.js",
    "src/client/WebSearchCard.js",
    "src/client/PluginCard.js",
    "src/client/PluginCard.css",
    "src/client/PluginCard.css.js",
    "src/client/fields.js",
    "src/client/fields.css",
    "src/client/fields.css.js",
    "src/client/PluginsSettingsSection.js",
    "src/client/PluginsSettingsSection.css",
    "src/client/PluginsSettingsSection.css.js",
    "src/client/ConfigurablePluginsTab.js",
    "src/client/agent-loop-card-controller.js",
    "src/client/bash-card-controller.js",
    "src/client/card-form.js",
    "src/client/locales.js",
    "src/client/slot-contract.js",
    "src/client/tab-store.js",
    "src/client/web-search-card-controller.js"
  ],
  "dependencies": {
    "clsx": "^2.0.0",
    "webjsx": "^0.0.73"
  }
}
