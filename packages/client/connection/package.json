{
  "name": "@freddie/freddie-client-connection",
  "description": "Wire consumer layer: HTTP-up/WebSocket-down client, ConnectionController dual streams with reconnect, and fixture api",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lanmower/freddie.git",
    "directory": "packages/client/connection"
  },
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": {
      "default": "./src/index.js"
    },
    "./invariant": {
      "default": "./src/invariant.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [],
      "platform": "web",
      "immediately": true
    }
  },
  "license": "MIT",
  "dependencies": {
    "@freddie/schemastery": "workspace:^",
    "ws": "^8.21.0"
  },
  "files": [
    "src/**/*.js"
  ],
  "peerDependencies": {
    "@freddie/freddie-host-webserver": "workspace:^",
    "@freddie/freddie-invariants": "workspace:^",
    "@freddie/cordis": "workspace:^",
    "@freddie/freddie-attachment": "workspace:^",
    "@freddie/freddie-host-apiproxy": "workspace:^",
    "@freddie/freddie-commands": "workspace:^",
    "@freddie/freddie-llm": "workspace:^",
    "@freddie/freddie-session": "workspace:^",
    "@freddie/freddie-tools": "workspace:^"
  },
  "devDependencies": {
    "@freddie/freddie-host-webserver": "workspace:^",
    "@freddie/freddie-invariants": "workspace:^",
    "@types/ws": "^8.18.1",
    "@freddie/cordis": "workspace:^",
    "@freddie/freddie-attachment": "workspace:^",
    "@freddie/freddie-host-apiproxy": "workspace:^",
    "@freddie/freddie-commands": "workspace:^",
    "@freddie/freddie-llm": "workspace:^",
    "@freddie/freddie-session": "workspace:^",
    "@freddie/freddie-tools": "workspace:^"
  }
}
