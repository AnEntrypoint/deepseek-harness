{
  "name": "@freddie/freddie-typert-generator",
  "description": "TypeScript project analyzer and model-driven Typert artifact generator",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lanmower/freddie.git",
    "directory": "packages/typert/generator"
  },
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": {
      "default": "./src/index.js"
    },
    "./tsdown": {
      "default": "./src/tsdown-plugin.js"
    },
    "./invariant": {
      "default": "./src/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "src/*.js"
  ],
  "license": "MIT",
  "dependencies": {
    "@jridgewell/gen-mapping": "^0.3.13",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@freddie/freddie-invariants": "workspace:^",
    "@freddie/cordis": "workspace:^"
  },
  "devDependencies": {
    "@freddie/freddie-invariants": "workspace:^",
    "@freddie/freddie-tool-cordis": "workspace:^",
    "@freddie/freddie-typert-registry": "workspace:^",
    "@freddie/cordis": "workspace:^",
    "zod": "^4.4.3"
  }
}
