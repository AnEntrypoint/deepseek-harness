{
  "name": "@freddie/cordis-plugin-hmr",
  "description": "Hot Module Replacement Plugin for Cordis",
  "version": "1.0.16",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lanmower/freddie.git",
    "directory": "vendor/hmr"
  },
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "src"
  ],
  "author": "Shigma <shigma10826@gmail.com>",
  "license": "MIT",
  "@freddie/cordis": {
    "services": {
      "required": [
        "timer"
      ]
