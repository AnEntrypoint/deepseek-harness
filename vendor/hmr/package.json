  },
  "peerDependencies": {
    "@freddie/cordis-plugin-timer": "workspace:^",
    "@freddie/cordis": "workspace:^"
  },
  "dependencies": {
    "@babel/code-frame": "^7.29.0",
    "chokidar": "^5.0.0",
    "@freddie/cordis-plugin-loader": "workspace:^",
    "@freddie/cosmokit": "workspace:^",
    "picomatch": "^4.0.3",
    "@freddie/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@types/babel__code-frame": "^7.27.0",
    "@types/picomatch": "^3.0.2",
    "esbuild": "^0.28.1"
